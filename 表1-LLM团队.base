formulas:
  未命名: ""
views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("LLM研究调研-2026-06/团队卡片")
    order:
      - file.name
      - leader
      - representative_work
      - leader_note
      - region
      - retrieved
    sort:
      - property: representative_work
        direction: ASC
      - property: scope
        direction: DESC
      - property: formula.未命名
        direction: ASC
    columnSize:
      note.representative_work: 630
  - type: table
    name: 视图
